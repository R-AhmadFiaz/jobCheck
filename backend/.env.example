# Environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=5000

# MongoDB Atlas connection string (mongodb+srv://... in production)
MONGODB_URI=mongodb://localhost:27017/jobcheck

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Secret used to sign short-lived JWT access tokens — use a long random value in every environment
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Access token lifetime (jsonwebtoken duration string)
JWT_ACCESS_EXPIRES_IN=15m

# How long an opaque refresh token stays valid before it must be re-issued via login
REFRESH_TOKEN_TTL_DAYS=30
