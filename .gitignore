# Dependencies
node_modules/

# Build outputs
dist/
build/

# Environment — ignore every real env file at any depth (backend/, frontend/,
# or elsewhere), but always keep the .env.example templates tracked so the
# required variable names stay documented. The negation must come after the
# broad pattern, per gitignore rules.
.env
.env.*
*.local
!.env.example
!**/.env.example

# Logs
*.log
npm-debug.log*
logs/

# Editor/OS
.DS_Store
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln

# Testing
coverage/

# Vite
.vite/
