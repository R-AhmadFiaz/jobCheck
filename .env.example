# Environment: development | test | production
NODE_ENV=development

# MongoDB connection string.
#
# For Atlas: use the STANDARD (non-SRV) connection string, not the
# `mongodb+srv://cluster.mongodb.net/...` form Atlas's UI shows by default.
# This is a proven fix, not a preference — the `+srv` form requires a DNS
# SRV/TXT lookup before the driver can connect at all
# (mongodb/lib/connection_string.js calls `dns.promises.resolve(host,
# 'SRV')`), and that lookup was confirmed to fail unpredictably as soon as
# two requests need it at the same time (ECONNREFUSED, then EDESTRUCTION on
# retry — a Node/c-ares fragility, not an app bug) — see src/lib/db.ts for
# the full writeup. A standard connection string lists the actual replica
# set members directly and only ever needs a plain A-record lookup
# (`dns.lookup`), which was stress-tested under the same concurrency and
# never failed.
#
# To build one from an Atlas `+srv` string: in the Atlas UI's Connect
# dialog, look for "Standard connection string" (sometimes under a
# driver-version/legacy toggle) — it lists the actual shard hosts and
# replica set name for you, in this exact shape:
# mongodb://<username>:<password>@shard-00-00.xxxxx.mongodb.net:27017,shard-00-01.xxxxx.mongodb.net:27017,shard-00-02.xxxxx.mongodb.net:27017/jobcheck?ssl=true&replicaSet=atlas-xxxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
#
# Local dev (no Atlas): mongodb://localhost:27017/jobcheck
MONGODB_URI=mongodb://localhost:27017/jobcheck

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Secret used to sign short-lived JWT access tokens — use a long random value in every environment
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Access token lifetime (jsonwebtoken duration string)
JWT_ACCESS_EXPIRES_IN=15m

# How long an opaque refresh token stays valid before it must be re-issued via login
REFRESH_TOKEN_TTL_DAYS=30

# Max upload size (MB) accepted by the public/anonymous analysis endpoint
PUBLIC_ANALYSIS_MAX_FILE_SIZE_MB=5

# Guest analysis rate limit — window (ms) and max requests per IP within that window
PUBLIC_ANALYSIS_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_ANALYSIS_RATE_LIMIT_MAX=10

# Authenticated analysis rate limit — window (ms) and max requests per user
# account within that window. Backed by an in-memory store for local
# migration testing only — see src/lib/rateLimit/store.ts. MUST be swapped
# for a shared/distributed store before any real deployment.
AUTHENTICATED_ANALYSIS_RATE_LIMIT_WINDOW_MS=900000
AUTHENTICATED_ANALYSIS_RATE_LIMIT_MAX=30

# Login/registration rate limits — IP-keyed, same in-memory store as above.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5

# URL content extraction (guest analyzer) — request timeout and max response size read
URL_EXTRACTION_TIMEOUT_MS=8000
URL_EXTRACTION_MAX_BYTES=2097152

# Optional Gemini AI layer (input-quality validation + post-score explanation).
# Leave GEMINI_API_KEY blank to run JobCheck with the rule engine only — every
# feature still works without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=8000

# Groq AI provider (primary AI analysis layer) — an additional, advisory
# intelligence layer alongside the deterministic rule engine, never a
# replacement for it. Leave GROQ_API_KEY blank and/or AI_ENABLED=false to
# run JobCheck exactly as before this layer existed.
AI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=8000
